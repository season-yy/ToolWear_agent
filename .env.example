# “刃知”刀具磨损监测算法辅助平台示例配置
# 使用时复制为 .env，并在本机填写真实密钥。不要提交真实 .env。

# 大模型配置：默认使用千问 OpenAI 兼容接口
# 默认模型不可用或额度不足时，可切换到 qwen3.7-max-2026-05-20、
# qwen3.7-max-2026-05-17、qwen3.6-flash、qwen3.6-plus-2026-04-02、
# qwen3.6-plus、qwen3.6-max-preview、qwen3.6-27b 或 qwen3.6-flash-2026-04-16。
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash-2026-07-15
LLM_TIMEOUT_SECONDS=90

# ToolWear API 的可选鉴权 Token。本机调试可留空，接入 AgentTeams 前应设置。
TOOL_API_TOKEN=
# 推荐把 Token 放在 Git 之外的文件中；未配置时默认读取 AI_INFRA_ROOT/secrets/toolwear_api_token。
TOOL_API_TOKEN_FILE=D:/AI_infra/secrets/toolwear_api_token

# 项目路径配置：仓库根目录由代码自动计算，通常只需要设置 AI_INFRA_ROOT。
# 下列细分路径留空时都会从 AI_INFRA_ROOT 自动派生。
PROJECT_ROOT=F:/Toolwear_agent
APP_ROOT=F:/Toolwear_agent/toolwear_agent_app
AI_INFRA_ROOT=D:/AI_infra
DATASET_MANIFEST=D:/AI_infra/datasets/manifests/phm2010.yaml
PHM2010_RAW_ROOT=D:/AI_infra/datasets/raw/phm2010
EXPERIMENT_ROOT=D:/AI_infra/experiments/runs
ARTIFACT_ROOT=D:/AI_infra/artifacts
LOG_ROOT=D:/AI_infra/logs
STATE_ROOT=D:/AI_infra/state
STATE_DB_PATH=D:/AI_infra/state/toolwear.db
REPORT_ROOT=D:/AI_infra/reports
EVIDENCE_ROOT=D:/AI_infra/evidence
GENERATED_CODE_ROOT=D:/AI_infra/generated_code
CACHE_ROOT=D:/AI_infra/cache

# 训练默认参数：第一版 Demo 以四阶段磨损分类为主
TRAIN_DEVICE=cuda
RANDOM_SEED=42
PRIMARY_TASK=four_stage_classification
ENABLE_VB_REGRESSION=false
VB_AGGREGATION=max
VB_STAGE_THRESHOLDS_UM=90,130,160

# 本地服务端口：FastAPI 做后端，Streamlit 做试验台界面
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=18100
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=18101
